  "type": "module",
  "exports": {
    "./shard": "./shared/shard.js",
    "./structure": "./shared/structure.js",
    "./resources": "./webgpu/resources.js",
    "./cpu": "./cpu/index.js",
    "./features": "./shared/features.js",
    "./sampler": "./shared/sampler.js",
    "./weights": "./shared/weights.js",
    "./packed-linear": "./webgpu/linear.js",
    "./gpu-weights": "./webgpu/weights.js",
    ".": "./webgpu/index.js",
